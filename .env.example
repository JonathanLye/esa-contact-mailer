PORT=8787

# Required — SMTP credentials (QQ Mail auth code by default)
SMTP_USER=your-email@example.com
SMTP_PASS=your-smtp-auth-code
CONTACT_TO=your-email@example.com

# Optional — defaults target QQ Mail; override for Gmail / Outlook / self-hosted
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true

# Optional branding used in owner notify + visitor auto-reply
FROM_DISPLAY_NAME=Website Contact
SITE_NAME=

# Comma-separated CORS allowlist (local + production)
ALLOWED_ORIGIN=http://localhost:5173,https://example.com

# Optional reverse-proxy shared secret. Leave blank for local Vite proxy.
# In production, have nginx set header X-Contact-Proxy-Token to the same value.
CONTACT_PROXY_TOKEN=

# ===== Optional: Aliyun ESA AI Captcha =====
# Soft-disable: leave these blank (captchaConfigured=false, no-op).
# Hard-remove: delete BEGIN/END Aliyun ESA AI Captcha blocks in index.js and
#   npm uninstall @alicloud/captcha20230305 @alicloud/openapi-core
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
CAPTCHA_SCENE_ID=
CAPTCHA_REGION=cn
